{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "CHART 1 - Line chart with a light area (basic idiom). Shows how Australia's certified organic land changed from 2004 to 2023. Why a line: year is an ordered key and the task is a trend, and position on a common scale (x = year, y = million hectares) is the most accurate channel. The y axis starts at 0 so growth is not exaggerated. Data: FAO via Our World in Data (organic_area.csv). Transforms: keep only Australia's rows, then divide hectares by 1,000,000 so the axis reads in millions. The x and y encodings at the top are shared by every layer below.",
  "title": {
    "text": "Certified organic agricultural land in Australia, million hectares, 2004–2023",
    "anchor": "start",
    "font": "'Source Sans 3', sans-serif",
    "fontSize": 16,
    "fontWeight": 400,
    "color": "#5f5f5f",
    "offset": 16,
    "lineHeight": 20
  },
  "width": "container",
  "height": 340,
  "data": {
    "url": "data/organic_area.csv",
    "format": {
      "type": "csv",
      "parse": {"year": "number", "organic_ha": "number"}
    }
  },
  "transform": [
    {"filter": "datum.code == 'AUS'"},
    {"calculate": "datum.organic_ha / 1000000", "as": "organic_m"}
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Year",
      "scale": {"domain": [2004, 2023]},
      "axis": {
        "format": "d",
        "values": [2004, 2005, 2006, 2007, 2008, 2009, 2010, 2011, 2012, 2013, 2014, 2015, 2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023],
        "grid": false,
        "labelAngle": 0,
        "labelFlush": false,
        "titlePadding": 10
      }
    },
    "y": {
      "field": "organic_m",
      "type": "quantitative",
      "title": "Million hectares",
      "scale": {"domain": [0, 60]},
      "axis": {"tickCount": 6}
    }
  },
  "layer": [
    {
      "description": "Layer 1: a very faint orange area under the line (opacity 0.1) to give a sense of 'amount of land' without adding much ink.",
      "mark": {"type": "area", "color": "#d95f02", "opacity": 0.1}
    },
    {
      "description": "Layer 2: the orange trend line itself (orange = Australia across the whole page).",
      "mark": {"type": "line", "color": "#d95f02", "strokeWidth": 3}
    },
    {
      "description": "Layer 3: a dot for each year; hovering over a dot shows a tooltip with the exact value (details on demand).",
      "mark": {"type": "point", "color": "#d95f02", "filled": true, "opacity": 1, "size": 45},
      "encoding": {
        "tooltip": [
          {"field": "year", "type": "quantitative", "title": "Year", "format": "d"},
          {"field": "organic_m", "type": "quantitative", "title": "Organic land (million ha)", "format": ".1f"}
        ]
      }
    },
    {
      "description": "Layer 4: direct labels for the first and last values (12.1M ha and 53.0M ha). The filter keeps only 2004 and 2023; the align expression puts the 2004 label to the right of its point and the 2023 label to the left, so both stay inside the chart.",
      "transform": [
        {"filter": "datum.year == 2004 || datum.year == 2023"},
        {"calculate": "format(datum.organic_m, '.1f') + 'M ha'", "as": "label"}
      ],
      "mark": {
        "type": "text",
        "align": {"expr": "datum.year == 2004 ? 'left' : 'right'"},
        "dy": -18,
        "fontSize": 16,
        "fontWeight": 600,
        "color": "#2b2b2b"
      },
      "encoding": {
        "text": {"field": "label"}
      }
    },
    {
      "description": "Layer 5: grey text annotations that explain the jump in 2013-2017 and the flat period. Their positions are typed in (inline 'values'), but the text describes what the data shows.",
      "data": {
        "values": [
          {"year": 2014.6, "organic_m": 32, "label": "2013–2017: organic land"},
          {"year": 2014.6, "organic_m": 29, "label": "more than triples"},
          {"year": 2019.5, "organic_m": 40.5, "label": "Same total reported each year, 2017–2022"}
        ]
      },
      "mark": {
        "type": "text",
        "align": {"expr": "datum.year > 2017 ? 'center' : 'right'"},
        "fontSize": 14,
        "color": "#5f5f5f"
      },
      "encoding": {
        "text": {"field": "label"}
      }
    }
  ],
  "config": {
    "background": "transparent",
    "font": "'Source Sans 3', sans-serif",
    "view": {"stroke": null},
    "axis": {
      "labelFont": "'Source Sans 3', sans-serif",
      "titleFont": "'Source Sans 3', sans-serif",
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": 400,
      "titleColor": "#5f5f5f",
      "labelColor": "#5f5f5f",
      "gridColor": "#e6e6e6",
      "domainColor": "#999999",
      "tickColor": "#999999"
    },
    "text": {"font": "'Source Sans 3', sans-serif"}
  }
}