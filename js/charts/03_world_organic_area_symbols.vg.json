{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "CHART 3 - Proportional symbol map (advanced idiom: map). Shows the 15 countries with the most certified organic land in 2023. Why symbols: hectares is a raw total, and totals belong on symbols rather than coloured areas. Circle AREA shows hectares (in Vega-Lite 'size' is area in square pixels, and the scale starts at 0, so area is proportional to the value). Australia is orange and the other countries are warm grey, so attention goes to Australia (figure-ground). Projection: Equal Earth (equal-area).",
  "width": "container",
  "height": 480,
  "projection": {"type": "equalEarth"},
  "layer": [
    {
      "description": "Layer 1: grey base map of every country except Antarctica.",
      "data": {
        "url": "data/ne_110m_admin_0_countries.topojson",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
      },
      "transform": [{"filter": "datum.properties.ADM0_A3 != 'ATA'"}],
      "mark": {"type": "geoshape", "fill": "#e3e1dc", "stroke": "#ffffff", "strokeWidth": 0.5}
    },
    {
      "description": "Layer 2: the circles. Transforms: keep 2023 real countries with data; 'window' ranks them by hectares (largest = 1); keep the top 15; convert to million ha; 'lookup' adds each country's centre point (lon/lat) from country_points.csv (Google DSPL centroids). 'order' draws large circles first so small ones stay visible on top; the white stroke separates overlapping circles.",
      "data": {
        "url": "data/organic_area.csv",
        "format": {"type": "csv", "parse": {"year": "number", "organic_ha": "number"}}
      },
      "transform": [
        {"filter": "datum.year == 2023 && length(datum.code) == 3 && isValid(datum.organic_ha)"},
        {
          "window": [{"op": "rank", "as": "rank"}],
          "sort": [{"field": "organic_ha", "order": "descending"}]
        },
        {"filter": "datum.rank <= 15"},
        {"calculate": "datum.organic_ha / 1000000", "as": "organic_m"},
        {
          "lookup": "code",
          "from": {
            "data": {
              "url": "data/country_points.csv",
              "format": {"type": "csv", "parse": {"lon": "number", "lat": "number"}}
            },
            "key": "code",
            "fields": ["lon", "lat"]
          }
        }
      ],
      "mark": {"type": "circle", "opacity": 0.75, "stroke": "#ffffff", "strokeWidth": 1},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "size": {
          "field": "organic_m",
          "type": "quantitative",
          "title": "Organic land (million ha)",
          "scale": {"domain": [0, 55], "range": [0, 6000]},
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "values": [1, 10, 50],
            "labelExpr": "datum.value + 'M ha'",
            "symbolFillColor": "#b8b2a7",
            "symbolStrokeColor": "#ffffff",
            "symbolOpacity": 0.75
          }
        },
        "color": {
          "condition": {"test": "datum.code == 'AUS'", "value": "#d95f02"},
          "value": "#b8b2a7"
        },
        "order": {"field": "organic_m", "sort": "descending"},
        "tooltip": [
          {"field": "country", "type": "nominal", "title": "Country"},
          {"field": "rank", "type": "quantitative", "title": "World rank"},
          {"field": "organic_m", "type": "quantitative", "title": "Organic land (million ha)", "format": ".2f"}
        ]
      }
    },
    {
      "description": "Layer 3: bold orange label 'Australia: 53.0M ha' placed in the ocean south of Australia.",
      "data": {"values": [{"lon": 134, "lat": -47, "label": "Australia: 53.0M ha"}]},
      "mark": {"type": "text", "fontSize": 15, "fontWeight": 600, "color": "#d95f02"},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "label"}
      }
    },
    {
      "description": "Layer 4: second annotation line, 'more than the next 14 countries combined' (checked: the next 14 add up to 32.5M ha).",
      "data": {"values": [{"lon": 134, "lat": -53, "label": "more than the next 14 countries combined"}]},
      "mark": {"type": "text", "fontSize": 15, "fontWeight": 400, "color": "#d95f02"},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "label"}
      }
    }
  ],
  "config": {
    "background": "transparent",
    "font": "'Source Sans 3', sans-serif",
    "view": {"stroke": null},
    "legend": {
      "labelFont": "'Source Sans 3', sans-serif",
      "titleFont": "'Source Sans 3', sans-serif",
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": 400,
      "titleColor": "#5f5f5f",
      "labelColor": "#5f5f5f"
    },
    "text": {"font": "'Source Sans 3', sans-serif"}
  }
}